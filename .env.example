# SERVICE_NAME=auth-service      # Port: 8081
# SERVICE_NAME=user-service      # Port: 8082
# SERVICE_NAME=channel-service   # Port: 8083
# SERVICE_NAME=chat-service      # Port: 8084
# SERVICE_NAME=voice-service     # Port: 8085
# SERVICE_NAME=stream-service    # Port: 8086
# SERVICE_NAME=presence-service  # Port: 8087

# Shared Database Configuration
APP_DATABASE__HOST="localhost"
APP_DATABASE__PORT=5432
APP_DATABASE__USERNAME="hermes"
APP_DATABASE__PASSWORD="hermes"
APP_DATABASE__DATABASE="hermes"

# Shared Infrastructure Configuration
APP_REDIS__HOST="127.0.0.1"
APP_REDIS__PORT=6379

APP_NATS__SERVERS="127.0.0.1:4222"

# Global Logging
APP_LOGGING__LEVEL="info"
APP_LOGGING__FORMAT="json"