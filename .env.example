# ============================================
# SQLX Configuration
# ============================================
DATABASE_URL=postgres://hermes:hermes@localhost:5432/hermes

# ============================================
# SERVICE IDENTITY
# ============================================

# SERVICE_NAME=gateway-service
# SERVICE_NAME=auth-service
# SERVICE_NAME=user-service
# SERVICE_NAME=channel-service
# SERVICE_NAME=chat-service
# SERVICE_NAME=voice-service
# SERVICE_NAME=stream-service
# SERVICE_NAME=presence-service


# ============================================
# DATABASE (PostgreSQL - Docker local)
# ============================================

APP_DATABASE__HOST=127.0.0.1
APP_DATABASE__PORT=5432
APP_DATABASE__USERNAME=hermes
APP_DATABASE__PASSWORD=hermes
APP_DATABASE__DATABASE=hermes

APP_DATABASE__MAX_CONNECTIONS=10
APP_DATABASE__MIN_CONNECTIONS=2
APP_DATABASE__ACQUIRE_TIMEOUT=30s
APP_DATABASE__IDLE_TIMEOUT=10m
APP_DATABASE__MAX_LIFETIME=30m


# ============================================
# CACHE (Redis - Docker local)
# ============================================

APP_REDIS__HOST=127.0.0.1
APP_REDIS__PORT=6379
APP_REDIS__USERNAME=
APP_REDIS__PASSWORD=redis_dev_password
APP_REDIS__DATABASE=0
APP_REDIS__MAX_CONNECTIONS=10


# ============================================
# MESSAGING (NATS - Docker local)
# ============================================

APP_NATS__SERVERS=127.0.0.1:4222
APP_NATS__USERNAME=
APP_NATS__PASSWORD=
APP_NATS__TOKEN=
APP_NATS__MAX_RECONNECT_ATTEMPTS=10


# ============================================
# SMTP (Mailpit - Docker local)
# ============================================

APP_SMTP__HOST=127.0.0.1
APP_SMTP__PORT=1025
APP_SMTP__USERNAME=
APP_SMTP__PASSWORD=
APP_SMTP__FROM_ADDRESS="no-reply@hermes.rs"
APP_SMTP__USE_TLS=false


# ============================================
# LOGGING
# ============================================

APP_LOGGING__LEVEL=info
APP_LOGGING__FORMAT=pretty


# ============================================
# SECRETS
# ============================================

APP_SECRETS__JWT__ACCESS_SECRET="your_very_secure_access_secret_32_chars_long"
APP_SECRETS__JWT__REFRESH_SECRET="your_very_secure_refresh_secret_32_chars_long"
APP_SECRETS__JWT__EXPIRATION_HOURS=24
APP_SECRETS__JWT__REFRESH_EXPIRATION_DAYS=30

APP_SECRETS__PASSWORD__PEPPER="super_secret_pepper_min_16_chars"
APP_SECRETS__PASSWORD__MIN_LENGTH=8
APP_SECRETS__PASSWORD__BCRYPT_COST=12


# ============================================
# gRPC ENDPOINTS (local services)
# ============================================

APP_GRPC_ENDPOINTS__AUTH_SERVICE=http://127.0.0.1:50051
APP_GRPC_ENDPOINTS__USER_SERVICE=http://127.0.0.1:50052
