# Hermes Environment Configuration
# Copy this file to .env and update with your values

# ============================================
# SERVICE IDENTITY
# ============================================
# Uncomment and set the service you want to run:
# SERVICE_NAME=gateway-service   # Port: 8080
# SERVICE_NAME=auth-service      # Port: 8081
# SERVICE_NAME=user-service      # Port: 8082
# SERVICE_NAME=channel-service   # Port: 8083
# SERVICE_NAME=chat-service      # Port: 8084
# SERVICE_NAME=voice-service     # Port: 8085
# SERVICE_NAME=stream-service    # Port: 8086
# SERVICE_NAME=presence-service  # Port: 8087

# Environment: development, staging, production
APP_ENV=development

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=postgres://hermes:hermes@localhost:5432/hermes

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_URL=redis://:redis_dev_password@localhost:6379

# ============================================
# NATS CONFIGURATION
# ============================================
NATS_URL=nats://localhost:4222

# ============================================
# OPTIONAL OVERRIDES
# ============================================
# Uncomment to override TOML values

# Service Configuration
# SERVICE_HOST=0.0.0.0
# SERVICE_PORT=8081

# Database Overrides
# DATABASE_MAX_CONNECTIONS=20
# DATABASE_MIN_CONNECTIONS=5

# Redis Overrides
# REDIS_POOL_SIZE=20

# Logging Overrides
# LOG_LEVEL=debug
# LOG_FORMAT=pretty

# Gateway Service URLs (only for gateway-service)
# GATEWAY_AUTH_SERVICE_URL=http://auth:8081
# GATEWAY_USER_SERVICE_URL=http://user:8082
# GATEWAY_CHANNEL_SERVICE_URL=http://channel:8083
# GATEWAY_CHAT_SERVICE_URL=http://chat:8084
# GATEWAY_VOICE_SERVICE_URL=http://voice:8085
# GATEWAY_STREAM_SERVICE_URL=http://stream:8086
# GATEWAY_PRESENCE_SERVICE_URL=http://presence:8087
