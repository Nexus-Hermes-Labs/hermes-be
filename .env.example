# ============================================
# SQLX Configuration (per-service DATABASE_URL for sqlx-cli)
# Runtime database host/name/ports live in config/*.toml.
# ============================================
DATABASE_URL_AUTH=postgres://hermes:hermes@localhost:5432/hermes_auth
DATABASE_URL_USER=postgres://hermes:hermes@localhost:5432/hermes_user
DATABASE_URL_GUILD=postgres://hermes:hermes@localhost:5432/hermes_guild
DATABASE_URL_CHANNEL=postgres://hermes:hermes@localhost:5432/hermes_channel
DATABASE_URL_MESSAGING=postgres://hermes:hermes@localhost:5432/hermes_messaging

# ============================================
# Runtime config selection / overrides
# Default is development. Docker Compose sets APP_CONFIG_ENV=docker.
# Use APP_* variables only for secrets or one-off overrides.
# ============================================
# APP_CONFIG_ENV=development
# APP_CONFIG_ENV=production

# ============================================
# SECRETS
# Keep real production secrets out of TOML and inject them via env.
# ============================================
APP_SECRETS__JWT__ISSUER="hermes"
APP_SECRETS__JWT__ACCESS_SECRET="your_very_secure_access_secret_32_chars_long"
APP_SECRETS__JWT__REFRESH_SECRET="your_very_secure_refresh_secret_32_chars_long"
APP_SECRETS__JWT__EXPIRATION_HOURS=24
APP_SECRETS__JWT__REFRESH_EXPIRATION_DAYS=30

APP_SECRETS__PASSWORD__PEPPER="super_secret_pepper_min_16_chars"
APP_SECRETS__PASSWORD__MIN_LENGTH=8
APP_SECRETS__PASSWORD__BCRYPT_COST=12

# OAUTH (auth-service only; optional — leave unset to disable social login)
# Credentials from the Google Cloud console. redirect_uri must point at the
# FRONTEND callback route (Architecture A): Google redirects the browser there,
# the SPA then POSTs {code, state} to auth-service.
# APP_OAUTH__GOOGLE__CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# APP_OAUTH__GOOGLE__CLIENT_SECRET="your-google-client-secret"
# APP_OAUTH__GOOGLE__REDIRECT_URI="http://localhost:3001/oauth/google/callback"

# Optional override examples:
# APP_SERVICE__PORT=18081
# APP_DATABASE__PASSWORD=...
# APP_LOGGING__LEVEL=debug
