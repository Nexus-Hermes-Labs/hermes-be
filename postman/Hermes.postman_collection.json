								"body": {
									"mode": "raw",
									"raw": "{\n    \"display_name\": \"Updated Name\",\n    \"bio\": \"New bio here\",\n    \"avatar_url\": \"https://example.com/avatar.png\"\n}"
								},
								"url": "http://localhost:8082/api/v1/users/{{user_id}}"
