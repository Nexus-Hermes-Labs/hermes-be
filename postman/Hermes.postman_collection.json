{
	"info": {
		"name": "Hermes API",
		"description": "Comprehensive collection for Hermes services with consolidated API versioning and fixed routing.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth Service",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"user@example.com\",\n    \"username\": \"testuser\",\n    \"display_name\": \"Test User\",\n    \"password\": \"SecurePass123!\"\n}"
						},
						"url": "http://localhost:8081/api/v1/auth/register"
					}
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"user@example.com\",\n    \"password\": \"SecurePass123!\"\n}"
						},
						"url": "http://localhost:8081/api/v1/auth/login"
					}
				},
				{
					"name": "Refresh Token",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refresh_token\": \"{{refresh_token}}\"\n}"
						},
						"url": "http://localhost:8081/api/v1/auth/refresh"
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refresh_token\": \"{{refresh_token}}\",\n    \"all_devices\": false\n}"
						},
						"url": "http://localhost:8081/api/v1/auth/logout"
					}
				},
				{
					"name": "Verify Email",
					"request": {
						"method": "GET",
						"url": "http://localhost:8081/api/v1/auth/verify-email?token={{verification_token}}"
					}
				}
			]
		},
		{
			"name": "User Service",
			"item": [
				{
					"name": "Profile",
					"item": [
						{
							"name": "Create Profile",
							"request": {
								"method": "POST",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"username\": \"newuser\",\n    \"display_name\": \"New User\"\n}"
								},
								"url": "http://localhost:8082/api/v1/users"
							}
						},
						{
							"name": "Get Profile",
							"request": {
								"method": "GET",
								"header": [
									{
										"key": "Authorization",
										"value": "Bearer {{access_token}}"
									}
								],
								"url": "http://localhost:8082/api/v1/users/{{user_id}}"
							}
						},
						{
							"name": "Get Profile by Username",
							"request": {
								"method": "GET",
								"header": [
